# From BotFather
TELEGRAM_BOT_TOKEN=your_token_here
# Any random string. Telegram sends it back on every webhook call so strangers can't hit your endpoint.
TELEGRAM_WEBHOOK_SECRET=pick_a_long_random_string
# Optional: only accept notes from this chat/channel id (the bot tells you the id if you send /id)
ALLOWED_CHAT_ID=

# From Google AI Studio. Used for scoring + keywords (and drafting if there is no Anthropic key)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: from console.anthropic.com. If set, drafts are written by Claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# gemini | claude. Leave empty to use claude when ANTHROPIC_API_KEY is set, otherwise gemini.
DRAFT_MODEL=

# Notes below this score get no draft
MIN_SCORE=6

# Supabase (Project Settings -> API). Optional, but without it nothing is saved and APPROVE/REJECT can't be recorded.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for `npm run set-webhook`
PUBLIC_URL=https://your-project.vercel.app
